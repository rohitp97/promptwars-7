# ── Live CPCB data (recommended) ─────────────────────────────────────────────
# Free key from https://data.gov.in (sign up → My Account → API key). Without it the app uses
# data.gov.in's public sample key, which returns only 10 rows per request (slower, more requests).
# This is a read-only key for public data; it is shipped in the bundle by design.
VITE_DATA_GOV_IN_KEY=

# ── Recommended: Firebase AI Logic ────────────────────────────────────────────
# Gemini is called through your Firebase project, so NO Gemini API key ships in the
# browser bundle. Copy these from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ── Local development only: direct Gemini key ─────────────────────────────────
# Honoured by `npm run dev`. Production builds IGNORE it (it is compiled out) unless you
# deliberately set VITE_ALLOW_CLIENT_KEY=true, which would ship the key to every visitor.
VITE_GEMINI_API_KEY=
# VITE_ALLOW_CLIENT_KEY=true

# ── Optional ─────────────────────────────────────────────────────────────────
# VITE_GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# VITE_USE_FIREBASE_AI=false
